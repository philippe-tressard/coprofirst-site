# Sert site/ derrière le tunnel Cloudflare. Le HTTPS est assuré par Cloudflare :
# Caddy n'écoute qu'en HTTP, sur 8080, publié
# sur 127.0.0.1 de l'instance seulement (compose.yaml) — rien hors du tunnel.
{
	admin off
	auto_https off
}

# Ce que porte toute réponse, page ou erreur : la compression et les en-têtes.
(reponse) {
	# Compression (coprofirst-site#28) : zstd ou gzip selon le navigateur, rien sans
	# Accept-Encoding — deployer.sh --verifier, qui n'en envoie pas, reçoit les octets
	# du dépôt tels quels.
	encode zstd gzip
	header {
		# Posés APRÈS la décision de compresser (defer) : encode ne compresse pas une
		# réponse qui porte déjà no-transform. Vérifié sur l'image par
		# scripts/verifier-service.sh (CI).
		defer
		# Seuls les fichiers du site : ni script, ni police, ni image d'ailleurs.
		# 'unsafe-inline' pour les styles seulement (<style> et style="" de la page).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# no-transform : Cloudflare ne réécrit pas la page (masquage des adresses
		# de courriel, minification) — ce qui est servi est ce qui est dans le dépôt.
		Cache-Control "public, max-age=300, no-transform"
		-Server
	}
}

:8080 {
	# www.coprofirst.fr → coprofirst.fr, et http → https (Cloudflare transmet le
	# protocole d'origine du visiteur dans X-Forwarded-Proto).
	@www host www.coprofirst.fr
	redir @www https://coprofirst.fr{uri} permanent
	@http header X-Forwarded-Proto http
	redir @http https://{host}{uri} permanent

	root * /srv
	file_server

	import reponse

	# Une adresse inconnue : 404.html, avec les MÊMES en-têtes que le reste du site.
	# Ce qui s'applique au site ne s'applique pas aux réponses d'erreur, d'où l'import
	# répété ici (coprofirst-site#4). file_server garde le code 404 de l'erreur.
	handle_errors {
		import reponse
		@introuvable expression {err.status_code} == 404
		handle @introuvable {
			rewrite * /404.html
			file_server
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}
}
