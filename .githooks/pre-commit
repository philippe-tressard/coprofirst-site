# Armé une fois par clone : git config core.hooksPath .githooks
racine="$(git rev-parse --show-toplevel)"
# La liste des contrôles hors réseau vit dans scripts/controles.sh, que la CI appelle
# aussi (coprofirst-site#130). Le référencement y lit l'arbre de travail, pas l'index.
bash "$racine/scripts/controles.sh" || exit 1
