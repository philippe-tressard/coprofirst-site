# Armé une fois par clone : git config core.hooksPath .githooks
racine="$(git rev-parse --show-toplevel)"
bash "$racine/scripts/verifier-depot.sh" || exit 1
# Le référencement lit l'arbre de travail, pas l'index : un fichier modifié mais non
# indexé est jugé tel qu'il est sur le disque. La CI, elle, juge ce qui est parti.
python3 "$racine/scripts/verifier-referencement.py"
